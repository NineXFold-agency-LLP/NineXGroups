# Production env for NineXGroups frontend (/root/apps/ninexfold/frontend/.env)
# Copy to frontend/.env on the droplet. Do not commit real secrets.

NEXT_PUBLIC_SITE_URL=https://ninexgroup.co.in

# AWS S3 for Blogs CMS (optional — without these, blog API returns empty list)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=
